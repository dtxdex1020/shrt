{
  "name": "shrt",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny self-hosted URL shortener. Hono, SQLite, one container.",
  "license": "MIT",
  "author": "Dex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtxdex1020/shrt.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "~12.9.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  }
}
